{
  "name": "registryhub-admin-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-24",
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "ADMIN_GITHUB_USER_ID": "323634447",
    "ADMIN_ORIGIN": "https://registryhub-admin-api.erfan8km.workers.dev",
    "GITHUB_OAUTH_CLIENT_ID": "Ov23li6wUJfsVoWDePLf",
    "GITHUB_REPOSITORY": "erfan8km/Health-Data-Hub"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OAUTH_STATE_STORE",
        "class_name": "OAuthStateStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "OAuthStateStore"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "323634447",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PROPOSAL_RATE_LIMITER",
      "namespace_id": "323634448",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
