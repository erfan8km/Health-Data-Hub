{
  "name": "iedr-static-catalogue",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @workspace/iedr run dev",
    "typecheck": "pnpm --filter @workspace/iedr run typecheck",
    "validate": "pnpm --filter @workspace/iedr run validate",
    "test": "pnpm --filter @workspace/iedr run test && node --test workers/registryhub-admin-api/src/validate.test.mjs workers/registryhub-admin-api/src/reports.test.mjs workers/registryhub-support-api/src/index.test.mjs",
    "build": "pnpm --filter @workspace/iedr run build",
    "check-links": "pnpm --filter @workspace/iedr run check-links"
  }
}
