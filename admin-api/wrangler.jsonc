{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "registryhub-admin-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "assets": {
    "directory": "../admin-prototype",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/health"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OAUTH_STATE_STORE",
        "class_name": "OAuthStateStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OAuthStateStore"]
    }
  ],
  "vars": {
    "GITHUB_REPOSITORY": "erfan8km/Health-Data-Hub",
    "ADMIN_ORIGIN": "https://registryhub-admin-api.erfan8km.workers.dev",
    "ADMIN_GITHUB_USER_ID": "323634447",
    "GITHUB_OAUTH_CLIENT_ID": "REPLACE_AFTER_REGISTERING_OAUTH_APP"
  },
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "323634447",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PROPOSAL_RATE_LIMITER",
      "namespace_id": "323634448",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
