# Optional: a public, browser-visible Cesium ion token restricted to your site domains in Cesium ion settings.
# When omitted, the globe attempts to use public Esri World Imagery tiles as a fallback.
VITE_CESIUM_ION_TOKEN=

# Public origin/base URL used at build time for canonical metadata and the sitemap.
# Include the repository path for GitHub Pages, e.g. https://username.github.io/repository/
SITE_URL=
