{
  "name": "@workspace/iedr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "validate": "node scripts/validate-data.mjs",
    "check-links": "node scripts/check-links.mjs",
    "test": "node --test scripts/test-catalogue.mjs scripts/test-globe-geo.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/validate-data.mjs && vite build --config vite.config.ts && node scripts/generate-seo.mjs && node scripts/copy-cesium-assets.mjs",
    "preview": "vite preview --config vite.config.ts --host 0.0.0.0"
  },
  "dependencies": {
    "cesium": "^1.132.0",
    "lucide-react": "^0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-cesium": "^1.2.23"
  }
}
